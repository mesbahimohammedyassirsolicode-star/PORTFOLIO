{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "security:audit": "npm audit --omit=dev",
    "security:headers": "node scripts/check-security-headers.mjs",
    "security:secrets": "node scripts/check-staged-secrets.mjs",
